<Window x:Class="MfgUnlockerInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MFG Unlocker - 1-Click Installer"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource BgWindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MFG Unlocker 1-Click Installer"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Automatic game detection, DLL conflict analysis, and 1-click install from dashdogy/MFG-Unlocker (Standalone Proxy DLL)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="GpuPillBorder"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="GpuStatusText"
                                   Text="Detecting GPU..."
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button x:Name="EnableHagsButton"
                            Content="Enable HAGS"
                            Style="{StaticResource BaseButtonStyle}"
                            Visibility="Collapsed"
                            Click="EnableHagsButton_Click"
                            Margin="0,0,8,0" />

                    <Border x:Name="ReleasePillBorder"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ReleaseStatusText"
                                   Text="Checking release..."
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button x:Name="CheckDownloadReleaseButton"
                            Content="Check / Download"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="CheckDownloadReleaseButton_Click"
                            Margin="0,0,6,0" />

                    <Button x:Name="ImportLocalButton"
                            Content="Import .zip / .dll"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="ImportLocalButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Game List -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanelBrush}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBox x:Name="SearchTextBox"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search games..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <!-- Filter Radio Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="FilterAllRadio"
                                     Content="All"
                                     IsChecked="True"
                                     Checked="FilterRadio_Changed"
                                     Margin="0,0,12,0" />
                        <RadioButton x:Name="FilterInstalledRadio"
                                     Content="Installed"
                                     Checked="FilterRadio_Changed"
                                     Margin="0,0,12,0" />
                        <RadioButton x:Name="FilterDbRadio"
                                     Content="In Compatibility DB"
                                     Checked="FilterRadio_Changed" />
                    </StackPanel>

                    <!-- Add / Rescan Actions -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="+ Browse .exe"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="AddExeButton_Click" />
                        <Button Grid.Column="2"
                                Content="+ Add Folder"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="AddFolderButton_Click" />
                        <Button x:Name="RescanButton"
                                Grid.Column="4"
                                Content="Rescan"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="RescanButton_Click" />
                    </Grid>

                    <!-- Count -->
                    <TextBlock x:Name="GamesCountText"
                               Grid.Row="3"
                               Text="0 games"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,6" />

                    <!-- Games List -->
                    <ListBox x:Name="GamesListBox"
                             Grid.Row="4"
                             ItemContainerStyle="{StaticResource GameListItemStyle}"
                             SelectionChanged="GamesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />

                                    <Border Grid.Row="0" Grid.Column="1"
                                            BorderThickness="1"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BadgeDefaultBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Installed">
                                                        <Setter Property="Background" Value="{StaticResource BadgeInstalledBg}" />
                                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusBadgeKind}" Value="AntiCheat">
                                                        <Setter Property="Background" Value="{StaticResource BadgeAntiCheatBg}" />
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Legacy">
                                                        <Setter Property="Background" Value="{StaticResource BadgeLegacyBg}" />
                                                        <Setter Property="BorderBrush" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Ready">
                                                        <Setter Property="Background" Value="{StaticResource BadgeReadyBg}" />
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BadgeDefaultFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Installed">
                                                            <Setter Property="Foreground" Value="{StaticResource BadgeInstalledFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusBadgeKind}" Value="AntiCheat">
                                                            <Setter Property="Foreground" Value="{StaticResource BadgeAntiCheatFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Legacy">
                                                            <Setter Property="Foreground" Value="{StaticResource BadgeLegacyFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusBadgeKind}" Value="Ready">
                                                            <Setter Property="Foreground" Value="{StaticResource BadgeReadyFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding SubtitleText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderSubtleBrush}" />

            <!-- Right Detail Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="14">
                <Grid>
                    <!-- Empty State -->
                    <Border x:Name="EmptyStatePanel"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="28"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Select a game to install MFG Unlocker"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Pick a game from the list on the left, click '+ Browse .exe' or '+ Add Folder', or drag and drop a game executable or folder onto this window."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="+ Browse .exe"
                                        Style="{StaticResource PrimaryBlueButton}"
                                        Click="AddExeButton_Click"
                                        Margin="0,0,8,0" />
                                <Button Content="+ Add Game Folder"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="AddFolderButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Game Detail Panel -->
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <!-- Header Card -->
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailGameTitle"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="{StaticResource BadgeDefaultBg}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Padding="7,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailSourceBadge"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="DetailStatusPill"
                                            Grid.Column="1"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="9,3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailStatusPillText"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                    <TextBlock Text="Executable (.exe):"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5" />
                                    <TextBlock x:Name="DetailExePath"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,6" />

                                    <TextBlock Text="Install directory:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5" />
                                    <TextBlock x:Name="DetailTargetDir"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Open Folder"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Click="OpenTargetFolderButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button Content="Change .exe"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Click="ChangeExeButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="RemoveManualButton"
                                            Content="Remove from List"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="RemoveManualButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Anti-Cheat Banner -->
                        <Border x:Name="AntiCheatBanner"
                                Visibility="Collapsed"
                                Background="#351417"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ANTI-CHEAT WARNING"
                                           FontWeight="Bold"
                                           Foreground="#FCA5A5"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="AntiCheatDetailsText"
                                           TextWrapping="Wrap"
                                           Foreground="#FECACA"
                                           FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <!-- Legacy Banner -->
                        <Border x:Name="LegacyBanner"
                                Visibility="Collapsed"
                                Background="#33220E"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Legacy mod files detected"
                                           FontWeight="Bold"
                                           Foreground="#FCD34D"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="LegacyDetailsText"
                                           TextWrapping="Wrap"
                                           Foreground="#FDE68A"
                                           FontSize="12.5" />
                            </StackPanel>
                        </Border>

                        <!-- Compatibility Info GroupBox -->
                        <GroupBox Header="Compatibility Details"
                                  Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DB Status:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBlock x:Name="CompatDbStatusText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Recommended DLL:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBlock x:Name="CompatPreferredText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,0,5" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Alternatives:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBlock x:Name="CompatAlternativesText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,5" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Avoid:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBlock x:Name="CompatAvoidText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,5" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBlock x:Name="CompatNotesText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,5" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Config &amp; Logs:" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="CompatFilesText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <!-- Install Configuration & Action GroupBox -->
                        <GroupBox Header="1-Click Install Configuration"
                                  Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="#142338"
                                        BorderBrush="#2B4C7E"
                                        BorderThickness="1"
                                        Padding="10,7"
                                        Margin="0,0,0,10">
                                    <TextBlock x:Name="RecommendationReasonText"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap"
                                               FontSize="12.5" />
                                </Border>

                                <TextBlock Text="Proxy DLL filename to install in game folder:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,4" />

                                <ComboBox x:Name="DllComboBox"
                                          DisplayMemberPath="DisplayText"
                                          SelectionChanged="DllComboBox_SelectionChanged"
                                          Margin="0,0,0,5" />

                                <TextBlock x:Name="DllSlotDetailText"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="2,0,0,12" />

                                <CheckBox x:Name="DeleteLogsCheckBox"
                                          Content="Delete log files (RTXMFG-*.log) on uninstall (keeps RTXMFG-Universal.json)"
                                          IsChecked="False"
                                          Margin="0,0,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PrimaryActionButton"
                                            Content="Install Now (1-Click)"
                                            Style="{StaticResource PrimaryGreenButton}"
                                            Click="PrimaryActionButton_Click"
                                            Margin="0,0,8,0" />

                                    <Button x:Name="UninstallButton"
                                            Content="Uninstall"
                                            Style="{StaticResource DangerRedButton}"
                                            Visibility="Collapsed"
                                            Click="UninstallButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- RTX 20xx / 30xx Optimization GroupBox -->
                        <GroupBox Header="RTX 20xx / 30xx Optimization (RTX40MFG-UI.ini)"
                                  Margin="0,0,0,10">
                            <StackPanel>
                                <Border x:Name="Rtx2030InfoBanner"
                                        Background="#142338"
                                        BorderBrush="#2B4C7E"
                                        BorderThickness="1"
                                        Padding="10,7"
                                        Margin="0,0,0,10">
                                    <TextBlock x:Name="Rtx2030InfoText"
                                               Foreground="#93C5FD"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Text="Configure compatibility &amp; frame-pacing options in RTX40MFG-UI.ini beside the game .exe." />
                                </Border>

                                <CheckBox x:Name="UnlockGameFgCheckBox"
                                          Content="Unlock hidden in-game Frame Generation toggle (GpuNameOverride=1)"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="Reports RTX 4090 to the game's UI check so titles that hide DLSS Frame Generation on RTX 20xx/30xx (e.g. Wuthering Waves) show the toggle. DLSS/driver still use your real GPU."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="22,0,0,10" />

                                <CheckBox x:Name="LegacyRtx30PacingCheckBox"
                                          Content="Use legacy V1.5.0 CPU frame pacing instead of driver flip metering (Rtx30FlipMetering=0)"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="Keep unchecked for default driver flip metering (recommended). Enable only if an RTX 30xx card experiences stutter or pacing issues."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="22,0,0,10" />

                                <CheckBox x:Name="AutoApplyOptOnInstallCheckBox"
                                          Content="Automatically write RTX40MFG-UI.ini on 1-Click Install"
                                          IsChecked="True"
                                          Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="ApplyRecommendedOptButton"
                                            Content="Apply Recommended (20xx/30xx)"
                                            Style="{StaticResource PrimaryBlueButton}"
                                            Click="ApplyRecommendedOptButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="SaveOptimizationButton"
                                            Content="Save INI Settings"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Click="SaveOptimizationButton_Click" />
                                </StackPanel>

                                <TextBlock x:Name="OptimizationStatusText"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <!-- Quick Guide GroupBox -->
                        <GroupBox Header="Quick Usage Guide">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Text="1. Launch the game normally.&#x0a;2. Enable Frame Generation in the game's graphics settings.&#x0a;3. Press Backspace in game to open the MFG Unlocker menu (opens automatically on first launch).&#x0a;4. If the menu does not appear and no RTXMFG-*.log is created beside the .exe, uninstall and choose an alternative DLL filename.&#x0a;5. RTX 20xx / 30xx tip: In the Backspace menu, set DLSS-G preset to Preset C (performance), keep multiplier at 2x–3x for lower latency, and ensure Windows HAGS is enabled." />
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           Text="Ready."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="MainProgressBar"
                             Grid.Column="1"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="10,0" />

                <Button x:Name="AdminButton"
                        Grid.Column="2"
                        Content="Run as Admin"
                        Style="{StaticResource BaseButtonStyle}"
                        Padding="10,3"
                        Click="AdminButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
